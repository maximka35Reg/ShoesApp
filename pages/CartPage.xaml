<Page x:Class="ShoesApp.pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesApp.pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource Header}" Orientation="Horizontal">
            <Border Margin="20 10" BorderBrush="#70B2AF" BorderThickness="2" CornerRadius="8">
                <Image Source="/images/app.png" Width="50" Height="50" Stretch="UniformToFill" />
            </Border>
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Назад" x:Name="PreviousBtnBtn" Click="PreviousBtnBtn_Click"/>
            <StackPanel x:Name="UserInfo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="550 0 0 0">
                <TextBlock Text="ФИО: " Margin="0 0 5 0" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="UserBlock" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal"  Grid.Row="1" Margin="20 30 20 0" HorizontalAlignment="Stretch" Width="1100">
            <TextBlock Style="{StaticResource Title}" Text="Корзина"/>

            <Button Content="Оформить заказ" x:Name="CreateOrderBtn" Click="CreateOrderBtn_Click" Padding="5" Height="40" Margin="650 0 30 0"/>
            <Button Content="Очистить корзину" x:Name="CleanCartBtn" Click="CleanCartBtn_Click" Height="40" Padding="5"/>
        </StackPanel>

        <StackPanel x:Name="ClientPanel" Orientation="Horizontal" Grid.Row="2"
            Margin="20 10 20 0" Visibility="Collapsed">
            <TextBlock Text="Клиент:" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <ComboBox x:Name="ClientCB" Width="350" Height="25" DisplayMemberPath="UserFio" SelectedValuePath="id"/>
        </StackPanel>

        <ListView Grid.Row="3" MouseDoubleClick="CatalogLV_MouseDoubleClick" x:Name="CartLV" HorizontalContentAlignment="Stretch" Margin="15 20">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding ProductName}" Width="300"/>
                    <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding SizeNum}" Width="80"/>
                    <GridViewColumn Header="Кол-во" DisplayMemberBinding="{Binding Amount}" Width="80"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding PricePerUnit, StringFormat={}{0:N2} руб.}" Width="120"/>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding Total, StringFormat={}{0:N2} руб.}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
