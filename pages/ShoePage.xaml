<Page x:Class="ShoesApp.pages.ShoePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesApp.pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource Header}" Orientation="Horizontal">
            <Border Margin="20 10" BorderBrush="#70B2AF" BorderThickness="2" CornerRadius="8">
                <Image Source="/images/app.png" Width="50" Height="50" Stretch="UniformToFill" />
            </Border>
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Назад" x:Name="PreviousBtnBtn" Click="PreviousBtnBtn_Click"/>
            <StackPanel x:Name="UserInfo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="550 0 0 0">
                <TextBlock Text="ФИО: " Margin="0 0 5 0" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="UserBlock" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="#70B2AF" BorderThickness="2" Margin="50" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="1100">
            <StackPanel  Orientation="Horizontal" >
                <Border BorderBrush="#70B2AF" BorderThickness="1"  Width="250" Height="250" Margin="50 0 50 0">
                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Orientation="Vertical" Width="600" Margin="0 15">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Производитель:" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding Production1.name_production}"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Наименование:" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding product_name}"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Категория:" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding Category1.category_name}"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Цена:" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2} руб.}"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Состав:" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding Structure}"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Описание:" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding description}" TextWrapping="Wrap" MaxWidth="600"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                        <TextBlock FontWeight="Bold" Text="Размерный ряд:" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding SizeRange}" TextWrapping="Wrap" MaxWidth="600"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Доступные размеры:" Margin="0 0 5 0"/>
                        <ComboBox x:Name="SizesCB" SelectionChanged="SizesCB_SelectionChanged" DisplayMemberPath="Size.num_size" SelectedValuePath="id_size"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Кол-во доступных товаров:" Margin="0 0 5 0"/>
                        <TextBlock x:Name="AmountBlock"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10 ">
                        <TextBlock FontWeight="Bold" Text="Кол-во товаров для заказа:" Margin="0 0 5 0"/>
                        <TextBox x:Name="CountOrderShoesBox" Width="30" />
                    </StackPanel>

                    <Button x:Name="AddToOrderBtn" HorizontalAlignment="Left" Margin="0 10" Padding="30 5" Click="AddToOrderBtn_Click" Content="Добавить в заказ" MaxWidth="250" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
