<Page x:Class="ShoesApp.pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesApp.pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource Header}" Orientation="Horizontal">
            <Border Margin="20 10" BorderBrush="#70B2AF" BorderThickness="2" CornerRadius="8">
                <Image Source="/images/app.png" Width="50" Height="50" Stretch="UniformToFill" />
            </Border>
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Назад" x:Name="PreviousBtnBtn" Click="PreviousBtnBtn_Click"/>
            <StackPanel x:Name="UserInfo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="550 0 0 0">
                <TextBlock Text="ФИО: " Margin="0 0 5 0" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="UserBlock" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="20 30 20 0" HorizontalAlignment="Stretch" Width="1100">
            <TextBlock Style="{StaticResource Title}" Text="Заказы"/>

            <Button Content="Добавить" x:Name="AddOrderBtn" Click="AddOrderBtn_Click" Margin="670 0 10 0" Padding="5" Visibility="Collapsed"/>
            <Button Content="Редактировать" x:Name="EditOrderBtn" Click="EditOrderBtn_Click" Padding="5" Margin="0 0 10 0" Height="40" Visibility="Collapsed" />
            <Button Content="Удалить" x:Name="DeleteOrderBtn" Click="DeleteOrderBtn_Click" Height="40" Padding="5" Visibility="Collapsed"/>
        </StackPanel>

        <ListView Grid.Row="2"  x:Name="OrdersLV" SelectionChanged="OrdersLV_SelectionChanged" HorizontalContentAlignment="Stretch" Margin="15 20">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Дата заказа" DisplayMemberBinding="{Binding date_order, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="180"/>
                    <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding ClientFio}" Width="400"/>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding Total, StringFormat={}{0:N2} руб.}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" Text="Состав выбранного заказа" FontWeight="Bold" Margin="20 10 0 0" FontSize="16" Foreground="#70B2AF"/>
        <ListView Grid.Row="4" x:Name="PositionsLV" Margin="15 5 15 20">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding ProductName}" Width="300"/>
                    <GridViewColumn Header="Производство" DisplayMemberBinding="{Binding ProductionName}" Width="200"/>
                    <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding SizeNum}" Width="80"/>
                    <GridViewColumn Header="Кол-во" DisplayMemberBinding="{Binding amount}" Width="80"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding price_per_unit, StringFormat={}{0:N2} руб.}" Width="120"/>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding LineTotal, StringFormat={}{0:N2} руб.}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
