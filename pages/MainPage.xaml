<Page x:Class="ShoesApp.pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesApp.pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource Header}" Orientation="Horizontal" Width="1100" HorizontalAlignment="Stretch">
            <Border Margin="20 10" BorderBrush="#70B2AF" BorderThickness="2" CornerRadius="8">
                <Image Source="/images/app.png" Width="50" Height="50" Stretch="UniformToFill" />
            </Border>
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Авторизация" x:Name="LoginBtn" Click="LoginBtn_Click"/>
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Заказы" x:Name="OrdersBtn" Click="OrdersBtn_Click"/>
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Корзина" x:Name="CartBtn" Click="CartBtn_Click" />
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Выйти" x:Name="LogoutBtn" Click="LogoutBtn_Click" />
            <StackPanel x:Name="UserInfo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="350 0 0 0">
                <TextBlock Text="ФИО: " Margin="0 0 5 0" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="UserBlock" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource Title}" Text="Каталог" Margin="20 15 0 0"/>

        <StackPanel x:Name="InstrumentsPanel" Orientation="Horizontal" Grid.Row="2" Margin="20 15 20 0" HorizontalAlignment="Stretch" Width="1100">
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Width="500"/>

            <ComboBox x:Name="FilterCB" SelectionChanged="FilterCB_SelectionChanged" Margin="200 0 20 0"/>

            <ComboBox x:Name="SortCB" SelectionChanged="SortCB_SelectionChanged">
                <ComboBoxItem Content="Сортировка" IsSelected="True" IsEnabled="False" />
                <ComboBoxItem Content="По возрастанию цены" />
                <ComboBoxItem Content="По убыванию цены" />
            </ComboBox>
        </StackPanel>

        <ListView Grid.Row="3" MouseDoubleClick="CatalogLV_MouseDoubleClick" x:Name="CatalogLV" HorizontalContentAlignment="Stretch" Margin="15 20">
            <ListView.ItemTemplate >
                <DataTemplate>
                    <Border Margin="5 8" BorderThickness="3" BorderBrush="#70B2AF">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLowCount}" Value="True">
                                            <Setter Property="Background" Value="#FF8080"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Image Source="{Binding ImagePath}" Width="200" Height="200"  Stretch="Uniform" Margin="20"/>

                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                                    <TextBlock FontWeight="Bold" FontSize="20" Text="{Binding Production1.name_production}" />
                                    <TextBlock FontWeight="Bold" FontSize="20" Text=" | " />
                                    <TextBlock FontWeight="Bold" FontSize="20" Text="{Binding product_name}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 40 0 0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Категория:" Margin="0 0 5 0"/>
                                            <TextBlock Text="{Binding Category1.category_name}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                            <TextBlock Text="Количество:" Margin="0 0 5 0"/>
                                            <TextBlock Text="{Binding CountDisplay}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                            <TextBlock Text="Состав:" Margin="0 0 5 0"/>
                                            <TextBlock Text="{Binding Structure}" TextWrapping="Wrap" Width="400"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="150 0 0 0">
                                        <TextBlock Text="{Binding price, StringFormat={}{0:N2} руб.}" TextDecorations="Strikethrough" Foreground="Gray" FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Price, StringFormat={}{0:N2} руб.}" x:Name="PriceBlock" FontWeight="Bold" FontSize="24"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
