<Page x:Class="ShoesApp.pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesApp.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource Header}" Orientation="Horizontal">
            <Border Margin="20 10" BorderBrush="#70B2AF" BorderThickness="2" CornerRadius="8">
                <Image Source="/images/app.png" Width="50" Height="50" Stretch="UniformToFill" />
            </Border>
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Назад" x:Name="PreviousBtnBtn" Click="PreviousBtn_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="20 30 20 0" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Title}" Margin="0 0 0 50" HorizontalAlignment="Center"  Text="АВТОРИЗАЦИЯ" />

            <TextBlock Text="Логин" FontSize="16"/>
            <TextBox x:Name="LoginBox" Width="300" Height="25" FontSize="16" Margin="0 0 0 40"/>

            <Button x:Name="LoginBtn" Width="250" Padding="10" Click="LoginBtn_Click" Content="Войти" />
        </StackPanel>
    </Grid>
</Page>
