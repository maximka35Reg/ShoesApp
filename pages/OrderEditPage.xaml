<Page x:Class="ShoesApp.pages.OrderEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoesApp.pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource Header}" Orientation="Horizontal">
            <Border Margin="20 10" BorderBrush="#70B2AF" BorderThickness="2" CornerRadius="8">
                <Image Source="/images/app.png" Width="50" Height="50" Stretch="UniformToFill" />
            </Border>
            <Button Margin="20 0" Style="{StaticResource HeaderBtn}" Padding="5" Content="Назад" x:Name="PreviousBtnBtn" Click="PreviousBtnBtn_Click"/>
            <StackPanel x:Name="UserInfo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="550 0 0 0">
                <TextBlock Text="ФИО: " Margin="0 0 5 0" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="UserBlock" Foreground="#70B2AF" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal"  Grid.Row="1" Margin="20 15 20 5" HorizontalAlignment="Stretch" Width="1100">
            <TextBlock Style="{StaticResource Title}" Text="Редактирование заказа"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20 10">
            <TextBlock Text="Дата заказа:" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <DatePicker x:Name="DateDp" Width="200"/>
        </StackPanel>

        <ListView Grid.Row="3" x:Name="PositionsLV" Margin="20 0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding ProductName}" Width="300"/>
                    <GridViewColumn Header="Производство" DisplayMemberBinding="{Binding ProductionName}" Width="200"/>
                    <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding SizeNum}" Width="80"/>
                    <GridViewColumn Header="Кол-во" DisplayMemberBinding="{Binding amount}" Width="80"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding price_per_unit, StringFormat={}{0:N2} руб.}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="20 15">
            <Button Content="Удалить позицию" x:Name="DeletePosBtn" Click="DeletePosBtn_Click" Padding="10 5" Margin="0 0 10 0"/>
            <Button Content="Сохранить" x:Name="SaveBtn" Click="SaveBtn_Click" Padding="10 5" Margin="0 0 10 0"/>
            <Button Content="Отмена" x:Name="CancelBtn" Click="CancelBtn_Click" Padding="10 5"/>
        </StackPanel>
    </Grid>
</Page>
